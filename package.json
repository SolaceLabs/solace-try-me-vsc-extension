{
  "name": "solace-try-me-vsc-extension",
  "displayName": "Solace Try Me VSC Extension",
  "description": "VSC built-in tool to visualize and observe events flowing through Solace PubSub+ Broker.",
  "version": "0.1.0",
  "publisher": "solace-tools",
  "author": {
    "name": "Cyrus Mobini"
  },
  "pricing": "Free",
  "icon": "media/solace-pubsub-logo.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SolaceLabs/solace-try-me-vsc-extension"
  },
  "homepage": "https://github.com/SolaceLabs/solace-try-me-vsc-extension/blob/main/README.md",
  "license": "Apache-2.0 license",
  "bugs": {
    "url": "https://github.com/SolaceLabs/solace-try-me-vsc-extension/issues"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:solaceTryMeVscExtension.newWindow"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "solaceTryMeVscExtension",
          "title": "Solace Try Me",
          "icon": "media/solace-pubsub-logo.png"
        }
      ]
    },
    "views": {
      "solaceTryMeVscExtension": [
        {
          "id": "solaceTryMeVscExtension.sideView",
          "name": "Solace Try Me",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "solaceTryMeVscExtension.newWindow",
        "title": "Open Solace Try Me in a New Tab",
        "category": "Solace Try Me",
        "icon": "$(empty-window)"
      },
      {
        "command": "solaceTryMeVscExtension.showConnections",
        "title": "Show Connections",
        "category": "Solace Try Me",
        "icon": "$(broadcast)"
      },
      {
        "command": "solaceTryMeVscExtension.disconnectAll",
        "title": "Disconnect All",
        "category": "Solace Try Me",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "solaceTryMeVscExtension.showLogs",
        "title": "Show Logs",
        "category": "Solace Try Me",
        "icon": "$(output)"
      },
      {
        "command": "solaceTryMeVscExtension.copyDiagnostics",
        "title": "Copy Diagnostics",
        "category": "Solace Try Me"
      },
      {
        "command": "solaceTryMeVscExtension.openGettingStarted",
        "title": "Getting Started",
        "category": "Solace Try Me",
        "icon": "$(question)"
      },
      {
        "command": "solaceTryMeVscExtension.startLocalBroker",
        "title": "Start a Local Broker (Docker)",
        "category": "Solace Try Me"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "solaceTryMeVscExtension.newWindow",
          "group": "navigation@1",
          "when": "view == solaceTryMeVscExtension.sideView"
        },
        {
          "command": "solaceTryMeVscExtension.disconnectAll",
          "group": "navigation@2",
          "when": "view == solaceTryMeVscExtension.sideView && solaceTryMe.anyConnected"
        },
        {
          "command": "solaceTryMeVscExtension.showLogs",
          "group": "overflow@1",
          "when": "view == solaceTryMeVscExtension.sideView"
        },
        {
          "command": "solaceTryMeVscExtension.copyDiagnostics",
          "group": "overflow@2",
          "when": "view == solaceTryMeVscExtension.sideView"
        },
        {
          "command": "solaceTryMeVscExtension.openGettingStarted",
          "group": "overflow@3",
          "when": "view == solaceTryMeVscExtension.sideView"
        }
      ],
      "commandPalette": [
        {
          "command": "solaceTryMeVscExtension.disconnectAll",
          "when": "solaceTryMe.anyConnected"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "solaceTryMe.gettingStarted",
        "title": "Get Started with Solace Try Me",
        "description": "Connect to a Solace broker, subscribe to a topic and publish your first message.",
        "steps": [
          {
            "id": "startBroker",
            "title": "Start a broker",
            "description": "You need a Solace PubSub+ event broker. Start one locally with Docker, or create a free Solace Cloud service.\n[Start a Local Broker](command:solaceTryMeVscExtension.startLocalBroker)",
            "media": {
              "markdown": "media/walkthrough/broker.md"
            },
            "completionEvents": [
              "onCommand:solaceTryMeVscExtension.startLocalBroker"
            ]
          },
          {
            "id": "openView",
            "title": "Open Solace Try Me",
            "description": "The Solace Try Me view lives in the Activity Bar. Its \"Default Localhost\" profile connects to ws://localhost:8008.\n[Open Solace Try Me](command:solaceTryMeVscExtension.sideView.focus)",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onView:solaceTryMeVscExtension.sideView"
            ]
          },
          {
            "id": "connect",
            "title": "Connect to the broker",
            "description": "In the Subscribe section, pick a broker profile and press Connect. Use \"Test connection\" in a broker profile to check its settings first.",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:solaceTryMe.connected"
            ]
          },
          {
            "id": "subscribe",
            "title": "Subscribe to a topic",
            "description": "Add the topic try-me/> and press Subscribe. Wildcards: * matches one level, > matches the rest.",
            "media": {
              "markdown": "media/walkthrough/subscribe.md"
            },
            "completionEvents": [
              "onContext:solaceTryMe.subscribed"
            ]
          },
          {
            "id": "publish",
            "title": "Publish a message",
            "description": "In the Publish section, connect, publish to try-me/hello and watch it arrive in Subscribe.",
            "media": {
              "markdown": "media/walkthrough/publish.md"
            },
            "completionEvents": [
              "onContext:solaceTryMe.published"
            ]
          },
          {
            "id": "openMessage",
            "title": "Open a message in the editor",
            "description": "Press the open button on a received message to see its payload, headers and user properties in an editor tab.",
            "media": {
              "markdown": "media/walkthrough/open-message.md"
            },
            "completionEvents": [
              "onContext:solaceTryMe.openedMessage"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:view": "cd webview && npm i && npm run build",
    "build": "npm run build:view && npm run compile",
    "lint": "eslint src",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "~1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3"
  }
}
